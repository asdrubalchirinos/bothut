---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotCard from '../../components/BotCard.astro';
import { grupoNecesidad } from '../../lib/etiquetas';

export async function getStaticPaths() {
  const necesidades = await getCollection('necesidades');
  return necesidades.map((necesidad) => ({
    params: { slug: necesidad.id },
    props: { necesidad },
  }));
}

const { necesidad } = Astro.props;
const { Content } = await render(necesidad);
const recomendados = (
  await Promise.all(necesidad.data.bots.map((id) => getEntry('bots', id)))
).filter((bot) => bot !== undefined);
---

<Base title={necesidad.data.titulo} description={necesidad.data.resumen}>
  <article class="wrap">
    <header class="ficha-head">
      <p class="kicker">{grupoNecesidad[necesidad.data.grupo]}</p>
      <h1>{necesidad.data.titulo}</h1>
      <p class="lead">{necesidad.data.resumen}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {recomendados.length > 0 ? (
      <section class="section">
        <h2>Bots que encajan</h2>
        <p class="muted">En este orden, según lo que suelen resolver mejor. Revisa siempre precio y país en la ficha.</p>
        <div class="card-grid">
          {recomendados.map((bot) => <BotCard bot={bot} />)}
        </div>
      </section>
    ) : (
      <p class="muted">En este lanzamiento no hay fichas propias para esta necesidad. Mira las guías enlazadas arriba.</p>
    )}
    <p><a href="/necesidades/">← Todas las necesidades</a></p>
  </article>
</Base>
